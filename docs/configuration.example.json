{
  "Receiver": {
    "BindAddress": "0.0.0.0",
    "UdpPort": 11003,
    "TcpPort": 11003,
    "PresetKeyEnvironmentVariable": "SURGARD_PRESET_KEY",
    "EnableUdp": true,
    "EnableTcp": true,
    "DuplicateWindowSeconds": 0
  },
  "Andromeda": {
    "Host": "127.0.0.1",
    "Port": 11004,
    "Prefix": "DEMO 00",
    "AckTimeoutSeconds": 10,
    "MaxReconnectDelaySeconds": 30
  },
  "Storage": {
    "SpoolDirectory": "C:\\ProgramData\\SurGardReplacement\\spool",
    "BlacklistFile": "C:\\ProgramData\\SurGardReplacement\\blacklist.json"
  },
  "Diagnostics": {
    "LogDirectory": "C:\\ProgramData\\SurGardReplacement\\logs",
    "StatusIntervalSeconds": 10
  }
}
